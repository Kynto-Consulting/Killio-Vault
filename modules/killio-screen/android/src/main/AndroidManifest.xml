<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    MediaProjection-typed foreground service + the invisible consent Activity.
    The FOREGROUND_SERVICE_MEDIA_PROJECTION permission is declared by the app
    manifest via the withVaultCapture config plugin so it merges into the APK.
  -->
  <application>
    <activity
      android:name="dev.killio.screen.ProjectionConsentActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:exported="false" />

    <service
      android:name="dev.killio.screen.ScreenCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />

    <!--
      System-audio (device playback) capture via AudioPlaybackCapture. Typed
      mediaProjection (required) + microphone so the same service can also mic
      when both-track capture is requested. The FOREGROUND_SERVICE_MEDIA_PROJECTION
      and FOREGROUND_SERVICE_MICROPHONE permissions are declared by the app
      manifest via the withVaultCapture config plugin.
    -->
    <service
      android:name="dev.killio.screen.SystemAudioCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection|microphone" />

    <!--
      DIRECT screenshot path (no MediaProjection): AccessibilityService that
      captures the screen via takeScreenshot() (API 30+). The user enables it
      once in Android's accessibility settings; afterwards Killio screenshots
      without the cast/recording consent prompt or status-bar cast icon.
      canTakeScreenshot=true (no content scraping) is declared in the linked
      res/xml/killio_accessibility_config.xml.
    -->
    <service
      android:name="dev.killio.screen.KillioScreenAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/killio_accessibility_config" />
    </service>
  </application>
</manifest>
