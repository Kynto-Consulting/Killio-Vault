<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.killio.screen" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
    MediaProjection-typed foreground service + the invisible consent Activity.
    The FOREGROUND_SERVICE_MEDIA_PROJECTION permission is declared by the app
    manifest via the withVaultCapture config plugin so it merges into the APK.
    -->
    <application>
        <activity
            android:name="dev.killio.screen.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="dev.killio.screen.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>