<?xml version="1.0" encoding="utf-8"?>
<!--
  Voice widget — pill-shaped tappable surface with a mic glyph and the
  "Hey Killio" label. Background is the cyan-tinted bg_widget drawable that
  matches the Vault brand palette.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_voice"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_mic"
        android:contentDescription="@string/widget_voice_label"
        android:layout_marginEnd="8dp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_voice_label"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
