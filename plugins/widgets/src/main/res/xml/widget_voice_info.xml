<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget provider info — describes the widget to the launcher.
  `keyguardWidgetCategory` lets the user pin it to the lockscreen on devices
  that support it (most stock Android). `resizeMode="horizontal|vertical"`
  + `widgetCategory="home_screen"` so users can place + resize it like any
  Android launcher widget.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="86400000"
    android:initialLayout="@layout/widget_voice"
    android:previewLayout="@layout/widget_voice"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_voice_desc" />
